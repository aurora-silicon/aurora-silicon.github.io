<button class="theme-toggle" type="button" aria-label="Switch to light theme" title="Switch theme">
  <svg class="sun" viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="3.5"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.4 1.4m11.2 11.2L19 19M5 19l1.4-1.4M17.6 6.4 19 5"/></svg>
  <svg class="moon" viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><path d="M20.2 15.4A8.5 8.5 0 0 1 8.6 3.8a8.5 8.5 0 1 0 11.6 11.6Z"/></svg>
</button>
<script>
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const media = window.matchMedia('(prefers-color-scheme: light)');
  function syncLabel() {
    const theme = document.documentElement.dataset.theme;
    button?.setAttribute('aria-label', `Switch to ${theme === 'light' ? 'dark' : 'light'} theme`);
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'light' ? '#ffffff' : '#000000');
  }
  syncLabel();
  button?.addEventListener('click', () => {
    const theme = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = theme;
    try { localStorage.setItem('starlight-theme', theme); } catch {}
    syncLabel();
  });
  media.addEventListener('change', () => {
    let saved: string | null = null;
    try { saved = localStorage.getItem('starlight-theme'); } catch {}
    if (saved !== 'dark' && saved !== 'light') {
      document.documentElement.dataset.theme = media.matches ? 'light' : 'dark';
      syncLabel();
    }
  });
</script>
