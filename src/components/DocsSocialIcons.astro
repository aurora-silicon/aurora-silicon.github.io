---
// The docs header's link group: the site's Blog and Support pages, as in the
// main navigation, then Starlight's social icons.
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
---
<a class="docs-nav-link" href="/blog/">Blog</a>
<a class="docs-nav-link" href="/devices/">Support</a>
<SocialIcons />

<style>
  .docs-nav-link { color: var(--sl-color-gray-2); font-size: var(--sl-text-sm); text-decoration: none; white-space: nowrap; }
  .docs-nav-link:hover { color: var(--sl-color-white); }
</style>
