---
import LucideIcon from './LucideIcon.astro';
interface Props { name: string; }
const { name } = Astro.props;
const icon = name === 'MacBook Pro' ? 'laptop'
  : name.startsWith('MacBook') ? 'laptop-minimal'
  : name === 'iMac' ? 'monitor' : 'pc-case';
---
<LucideIcon name={icon} class="device-icon" size={27} />
