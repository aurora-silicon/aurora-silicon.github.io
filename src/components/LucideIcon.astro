---
import icons from '../data/lucide-icons.json';
interface Props { name: string; class?: string; size?: number; }
const { name, class: className, size = 17 } = Astro.props;
// Static Lucide shapes imported from the supplied alternate website.
// See public/licenses/lucide.txt for the ISC and MIT notices.
const shapes = (icons as Record<string, string>)[name] ?? icons.cpu;
---
<svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={shapes} />
