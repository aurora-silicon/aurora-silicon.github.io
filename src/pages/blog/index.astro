---
import { getCollection } from 'astro:content';
import Site from '../../layouts/Site.astro';
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const formatDate = (date: Date) => date.toLocaleDateString('en', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Site title="Blog | Aurora Silicon" description="News and development updates from Aurora Silicon.">
  <section class="blog-page wrap" aria-labelledby="blog-title">
    <h1 id="blog-title">Blog</h1>
    {posts.length === 0 && <p class="post-list">No posts yet.</p>}
    <div class="post-list">{posts.map(post => <article><a href={`/blog/${post.id}/`}><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><h2>{post.data.title}</h2><p>{post.data.description}</p></a></article>)}</div>
  </section>
</Site>
