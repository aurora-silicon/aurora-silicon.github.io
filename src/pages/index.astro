---
import Site from '../layouts/Site.astro';
import MacBook from '../components/MacBook.astro';
import DownloadIcon from '../components/DownloadIcon.astro';
import SocialIcon from '../components/SocialIcon.astro';
import FeaturedDevice from '../components/FeaturedDevice.astro';
import { getCollection } from 'astro:content';
import { auroraInstallerUrl, omarchyUrl, socialLinks } from '../config';
const latestPost = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
---
<Site title="Aurora Silicon | Linux on Apple Silicon">
  <section class="hero wrap" aria-labelledby="hero-title">
    <MacBook>
    <div class="hero-copy">
      <div class="hero-heading"><img class="hero-logo" src="/brand/aurora-silicon-mark.svg" width="100" height="100" alt="" /><div class="hero-title-copy"><h1 id="hero-title">Linux on<br />Apple Silicon.</h1><p class="hero-subtitle">An open source platform for your Mac.</p></div></div>
      <div class="hero-actions">
        <a class="button primary" href="#omarchy"><DownloadIcon /> Download</a>
        <a class="button secondary" href="/devices/">Device support</a>
      </div>
    </div>
    </MacBook>
  </section>
  <section class="about-section wrap" aria-labelledby="about-title">
    <h2 id="about-title">About</h2>
    <div class="about-copy"><p>We aim to deliver a complete and polished Linux experience on Apple Silicon, from installation to everyday use. Our work spans the kernel, graphics drivers, and the tools that make it all work together.</p></div>
  </section>
  {latestPost && <section class="latest-section wrap" aria-labelledby="latest-title">
    <h2 id="latest-title">From the blog</h2>
    <a class="latest-post" href={`/blog/${latestPost.id}/`}>
      <time datetime={latestPost.data.date.toISOString()}>{latestPost.data.date.toLocaleDateString('en', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</time>
      <span class="latest-post-title">{latestPost.data.title}</span>
      <span class="latest-post-description">{latestPost.data.description}</span>
    </a>
  </section>}
  <FeaturedDevice />
  <section id="omarchy" class="omarchy-section wrap" aria-labelledby="omarchy-title">
    <h2 id="omarchy-title">Omarchy Mac</h2>
    <a class="omarchy-art" href={omarchyUrl} aria-label="View Omarchy Mac"><img src="/images/omarchy-desktop.webp" width="1600" height="900" alt="Omarchy desktop with the Vantablack theme, showing tiled terminals and a file manager" loading="lazy" decoding="async" /></a>
    <div class="omarchy-copy"><p>Omarchy is our flagship distribution as we worked together to bring you the best Linux experience on Apple Silicon Macs.</p><a class="button primary omarchy-download" href={omarchyUrl}><DownloadIcon /> Download</a></div>
  </section>
  <section class="aurora-linux-section wrap" aria-labelledby="aurora-linux-title">
    <h2 id="aurora-linux-title">Aurora Linux</h2>
    <div class="aurora-installer-art">
      <img class="installer-dark" src="/images/aurora-installer-dark.png" width="1904" height="1584" alt="Aurora Linux installer with distribution and desktop choices for a MacBook Neo" loading="lazy" decoding="async" />
      <img class="installer-light" src="/images/aurora-installer-light.png" width="1904" height="1584" alt="Aurora Linux installer with distribution and desktop choices for a MacBook Neo" loading="lazy" decoding="async" />
    </div>
    <p>Feel right at home with the distro of your choice. While Omarchy is our flagship distribution, we also offer installer setups for Fedora, Arch Linux, and NixOS.</p>
    <a class="button primary aurora-linux-download" href={auroraInstallerUrl}><DownloadIcon /> Download</a>
  </section>

  <section class="community-section wrap" aria-labelledby="community-title">
    <div class="community-intro"><h2 id="community-title">Community</h2><p>Follow the project. Join the conversation.</p></div>
    <nav class="community-links" aria-label="Aurora community">
      {socialLinks.map(link => <a href={link.href}><SocialIcon name={link.label} /><span>{link.label}</span></a>)}
    </nav>
  </section>
</Site>
